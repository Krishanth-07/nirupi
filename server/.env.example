# Get a key at https://aistudio.google.com/apikey — never commit the real .env
GEMINI_API_KEY=

# Optional overrides (defaults shown)
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TEXT_MODEL=gemini-3.8-flash
PORT=8080

# Repo used by the "Try demo" button (prepared in advance at server start)
DEMO_REPO_URL=https://github.com/expressjs/express
# Recruiter view (/recruiter) access key. Leave empty only for local testing.
RECRUITER_KEY=
# Optional GitHub token for git-history evidence (60 requests/hour without, 5,000 with).
# Create one at github.com/settings/tokens: fine-grained, public repositories read-only, no extra permissions.
GITHUB_TOKEN=
